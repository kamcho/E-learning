# Local development — copy to `.env` and adjust as needed.
#   cp .env.example .env

DEBUG=true
SECRET_KEY=local-dev-only-change-me

# Google Sign-In (OAuth 2.0 Web client ID)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:8000, http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
# Optional — OpenAI for AI tutor explanations and read-aloud
OPENAI_API_KEY=
# Optional WhatsApp Business Cloud API customer support (Meta webhook).
# Keep disabled until a webhook verify token, app secret, access token, and phone number ID are set.
WHATSAPP_SUPPORT_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_API_VERSION=v27.0
# WHATSAPP_SUPPORT_MODEL=gpt-4o-mini
# WHATSAPP_SUPPORT_TIMEOUT=12
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=nova
# OPENAI_TTS_PAUSE_LEVEL=long

# Local dev defaults (SQLite, no subscription gate)
SUBSCRIPTION_REQUIRED=false
