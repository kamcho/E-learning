# Local development — copy to `.env` and adjust as needed.
#   cp .env.example .env

DEBUG=true
SECRET_KEY=local-dev-only-change-me

# Google Sign-In (OAuth 2.0 Web client ID)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:8000, http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
# Optional — OpenAI for AI tutor explanations
OPENAI_API_KEY=

# Local dev defaults (SQLite, no subscription gate)
SUBSCRIPTION_REQUIRED=false
