# ==================================================================
# PRODUCTION .env  (copy this to `.env` ON THE DROPLET and fill in)
#   cp .env.production.example .env && nano .env
# NEVER commit the real .env to git.
# ==================================================================

# --- Core Django ---
# Generate a fresh key:  python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
DEBUG=False

# Your domain(s) and/or droplet IP, comma-separated (no spaces, no scheme)
ALLOWED_HOSTS=somasmartassesments.com,www.somasmartassesments.com,159.223.143.29

# CSRF origins — include http until Certbot HTTPS is enabled, then prefer https
CSRF_TRUSTED_ORIGINS=http://somasmartassesments.com,http://www.somasmartassesments.com,https://somasmartassesments.com,https://www.somasmartassesments.com,http://159.223.143.29

# --- PostgreSQL ---
DB_ENGINE=postgres
DB_NAME=elearning
DB_USER=elearning
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- HTTPS hardening ---
# Leave SECURE_SSL_REDIRECT=False until Certbot has issued a certificate,
# then set it to True and restart the service.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# After HTTPS works well, enable HSTS (start small, e.g. 3600, then raise to 31536000)
SECURE_HSTS_SECONDS=0

# --- OpenAI ---
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Soma Smart <noreply@somasmartassesments.com>

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=

# --- M-Pesa Daraja ---
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=https://somasmartassesments.com
SUBSCRIPTION_REQUIRED=true

# --- TextSMS ---
TEXTSMS_ENABLED=true
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=
